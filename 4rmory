#!/usr/bin/env bash
# 4rmory - find, install and audit the best AI agent skills and tools.
# Requires Bash 3.2+, git and awk. Optional: fzf, figlet, skillspector, skill-scanner.
# Licence: MIT. See README.md.

if [ -z "${BASH_VERSION:-}" ]; then
  echo "4rmory: please run with bash" >&2
  exit 1
fi

ar_resolve_self() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" && pwd
}

AR_HOME="$(ar_resolve_self)"

for ar_mod in core theme ui catalog install audit details cli; do
  if [ ! -r "$AR_HOME/lib/$ar_mod.sh" ]; then
    echo "4rmory: missing $AR_HOME/lib/$ar_mod.sh - the install is incomplete." >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  . "$AR_HOME/lib/$ar_mod.sh"
done
unset ar_mod

ar_main "$@"
